PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/chess

# Required. Use 32+ random characters in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Required in production: public origin(s) of the site, comma-separated.
# Used for Socket.IO CORS and the CSRF origin check.
# CLIENT_URL=https://chess.example.com

# Optional. Only fans out Socket.IO broadcasts; game state stays in memory,
# so run a single app instance either way.
# Upstash: use the rediss:// URL (TLS required)
# REDIS_URL=redis://127.0.0.1:6379

# Optional: expose Swagger UI at /api/v1/docs in production (always on in dev).
# ENABLE_API_DOCS=true

# Optional: LOG_LEVEL=info, DISCONNECT_GRACE_MS=30000
