<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - Chess Game</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/images/favicon.png" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <div class="page-grid"></div>
    <main class="page-shell">
      <div class="container split-layout">
        <section class="auth-hero">
          <span class="eyebrow">Build your identity</span>
          <h1 class="headline">Create a profile that feels tournament ready.</h1>
          <p>
            Register once, save your rating, personalize the board, and make
            every match feel like part of a real progression instead of a
            throwaway session.
          </p>

          <div class="auth-metrics">
            <div class="metric-card">
              <strong>Saved</strong>
              <span>Keep wins, losses, draws, and rating tied to your account.</span>
            </div>
            <div class="metric-card">
              <strong>Styled</strong>
              <span>Choose colors that make your board instantly yours.</span>
            </div>
            <div class="metric-card">
              <strong>Ready</strong>
              <span>Move from registration to your first match in seconds.</span>
            </div>
          </div>
        </section>

        <section class="auth-card panel-card">
          <div style="display: flex; justify-content: flex-end; margin-bottom: 12px">
            <a href="/" class="btn btn-ghost">Home</a>
          </div>
          <div>
            <h2>Create account</h2>
            <p>Start building your chess profile.</p>
          </div>

          <% if (error) { %>
          <div class="flash flash-error" role="alert"><%= error %></div>
          <% } %>

          <form action="/auth/register" method="POST" class="auth-form">
            <div class="field-group">
              <label for="username" class="field-label">Username</label>
              <input
                type="text"
                id="username"
                name="username"
                value="<%= username %>"
                required
                minlength="3"
                maxlength="20"
                class="field-input"
                placeholder="Choose a username"
              />
              <div class="field-help">3-20 characters</div>
            </div>

            <div class="field-group">
              <label for="email" class="field-label">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                value="<%= email %>"
                required
                class="field-input"
                placeholder="your@email.com"
              />
            </div>

            <div class="field-group">
              <label for="password" class="field-label">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="6"
                class="field-input"
                placeholder="Create a password"
              />
              <div class="field-help">Minimum 6 characters</div>
            </div>

            <button type="submit" class="btn btn-primary">Create Account</button>
          </form>

          <div class="auth-footer">
            Already have an account?
            <a href="/auth/login">Sign in here</a>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
