<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Create account' }) %>
  </head>
  <body>
    <%- include('partials/small-device') %>

    <main id="desktop-app" class="auth-page">
      <div class="auth-shell">
        <%- include('partials/auth-pitch') %>

        <section class="auth-card card" aria-labelledby="auth-title">
          <h2 id="auth-title">Create your account</h2>
          <p class="auth-lede">Get a rating, save your games and customise your board.</p>

          <% if (error) { %>
          <div class="flash flash-error" role="alert"><%= error %></div>
          <% } %>

          <form action="/auth/register" method="POST" class="auth-form">
            <div class="field-group">
              <label for="username" class="field-label">Username</label>
              <input
                type="text"
                id="username"
                name="username"
                value="<%= username %>"
                required
                minlength="3"
                maxlength="20"
                pattern="[A-Za-z0-9_-]+"
                title="Letters, numbers, underscores and hyphens only"
                autocomplete="username"
                class="field-input"
                aria-describedby="username-help"
              />
              <div id="username-help" class="field-help">3–20 letters, numbers, _ or -</div>
            </div>

            <div class="field-group">
              <label for="email" class="field-label">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                value="<%= email %>"
                required
                autocomplete="email"
                class="field-input"
                placeholder="you@example.com"
              />
            </div>

            <div class="field-group">
              <label for="password" class="field-label">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                minlength="8"
                maxlength="72"
                autocomplete="new-password"
                class="field-input"
                aria-describedby="password-help"
              />
              <div id="password-help" class="field-help">At least 8 characters</div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg btn-block">Create account</button>
          </form>

          <p class="auth-footer">
            Already have an account? <a href="/auth/login">Sign in</a>
          </p>
        </section>
      </div>
    </main>
  </body>
</html>
