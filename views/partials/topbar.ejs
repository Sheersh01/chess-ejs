<%
  const navItems = [
    { href: '/', label: 'Play', key: 'play' },
    { href: '/leaderboard', label: 'Leaderboard', key: 'leaderboard' },
    { href: '/games', label: 'My Games', key: 'games' },
    { href: '/profile', label: 'Profile', key: 'profile' },
  ];
  const current = typeof active !== 'undefined' ? active : '';
%>
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="app-topbar">
  <div class="container">
    <div class="topbar-card">
      <div class="topbar-glow" aria-hidden="true"></div>
      <div class="brand-lockup topbar-reveal">
        <div class="brand-mark" aria-hidden="true">♔</div>
        <div class="brand-copy">
          <div class="brand-kicker">
            <span class="brand-pulse" aria-hidden="true"></span>
            Live lobby
          </div>
          <h2><%= user.displayName || user.username %></h2>
          <p>Queue up for a match, tune your board, and keep the pressure on.</p>
        </div>
      </div>

      <div class="topbar-meta topbar-reveal topbar-reveal-delay-1">
        <div class="player-summary">
          <div class="status-pill status-pill-strong">
            <strong>Rating</strong>
            <span id="user-rating-value"><%= user.rating %></span>
          </div>
          <% if (user.isGuest) { %>
          <div class="guest-tag">Guest</div>
          <div class="status-pill">Stats are not saved for guests</div>
          <% } else { %>
          <div class="status-pill" title="Wins"><strong>W</strong><span><%= user.wins %></span></div>
          <div class="status-pill" title="Losses"><strong>L</strong><span><%= user.losses %></span></div>
          <div class="status-pill" title="Draws"><strong>D</strong><span><%= user.draws %></span></div>
          <% } %>
        </div>

        <nav class="topbar-actions topbar-reveal topbar-reveal-delay-2" aria-label="Main">
          <% navItems.forEach((item) => { %>
          <a
            href="<%= item.href %>"
            class="btn btn-ghost nav-btn<%= current === item.key ? ' nav-btn-active' : '' %>"
            <%- current === item.key ? 'aria-current="page"' : '' %>
          ><%= item.label %></a>
          <% }) %>
          <button
            type="button"
            id="settings-button"
            class="btn btn-ghost nav-icon-btn"
            aria-label="Settings"
            title="Settings"
          >⚙</button>
          <form action="/auth/logout" method="POST" class="nav-form">
            <button type="submit" class="btn btn-danger nav-btn">
              <%= user.isGuest ? 'Exit' : 'Logout' %>
            </button>
          </form>
        </nav>
      </div>
    </div>
  </div>
</header>
