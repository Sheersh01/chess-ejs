<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Play Chess' }) %>
  </head>
  <body
    style="--board-light:<%= user?.settings?.boardLight || '#f0d9b5' %>; --board-dark:<%= user?.settings?.boardDark || '#b58863' %>; --hint-color:<%= user?.settings?.hintColor || '#14551e' %>;"
  >
    <div class="page-grid"></div>
    <%- include('partials/small-device') %>

    <div id="desktop-app" class="page-shell">
      <%- include('partials/topbar', { user, active: 'play' }) %>

      <div id="connection-banner" class="connection-banner" role="status" hidden>
        Connection lost. Reconnecting…
      </div>

      <main id="main-content" tabindex="-1">
        <section id="landing-screen" class="landing-wrap">
          <div class="landing-grid">
            <div class="hero-panel panel-card">
              <span class="eyebrow">Modern Chess Arena</span>
              <h1 class="headline">Play sharper games in a room that feels alive.</h1>
              <p class="hero-copy">
                Queue for a live opponent, train against a tuned bot, and move
                through a cleaner interface built around focus, tempo, and board
                clarity.
              </p>

              <div class="hero-actions">
                <button id="play-online-button" class="btn btn-primary hero-button">
                  <span>
                    Play Online
                    <small>Match with a real opponent</small>
                  </span>
                  <strong>Live</strong>
                </button>

                <button id="play-bot-button" class="btn btn-secondary hero-button">
                  <span>
                    Play vs Bot
                    <small>Unrated practice with adjustable styles</small>
                  </span>
                  <strong>AI</strong>
                </button>
              </div>

              <p id="lobby-stats" class="lobby-stats" aria-live="polite">Loading live stats…</p>

              <div class="hero-stats">
                <div class="hero-stat">
                  <strong>1+0 → 15+10</strong>
                  <span>Bullet, blitz and rapid, with increment where it counts.</span>
                </div>
                <div class="hero-stat">
                  <strong>Premoves</strong>
                  <span>Queue your reply while the opponent thinks.</span>
                </div>
                <div class="hero-stat">
                  <strong>Review</strong>
                  <span>Step through every finished game move by move.</span>
                </div>
              </div>
            </div>

            <aside class="sidebar-panel panel-card" aria-labelledby="game-setup-title">
              <div class="panel-heading">
                <h3 id="game-setup-title">Game Setup</h3>
                <p>Your choices are remembered for next time.</p>
              </div>

              <div class="settings-grid">
                <div class="field-group">
                  <label for="time-control-select" class="field-label">Time Control</label>
                  <select id="time-control-select" class="field-select">
                    <option value="1+0">1 min · Bullet</option>
                    <option value="3+0">3 min · Blitz</option>
                    <option value="3+2">3 | 2 · Blitz</option>
                    <option value="5+0">5 min · Blitz</option>
                    <option value="10+0" selected>10 min · Rapid</option>
                    <option value="15+10">15 | 10 · Rapid</option>
                  </select>
                </div>

                <div class="field-group">
                  <label for="color-preference-select" class="field-label">Play As</label>
                  <select id="color-preference-select" class="field-select">
                    <option value="random" selected>Random</option>
                    <option value="white">White</option>
                    <option value="black">Black</option>
                  </select>
                </div>

                <div class="field-group">
                  <label for="bot-difficulty-select" class="field-label">Bot Difficulty</label>
                  <select id="bot-difficulty-select" class="field-select">
                    <option value="easy">Easy</option>
                    <option value="medium" selected>Medium</option>
                    <option value="hard">Hard</option>
                  </select>
                </div>

                <div class="field-group">
                  <label for="bot-personality-select" class="field-label">Bot Personality</label>
                  <select id="bot-personality-select" class="field-select">
                    <option value="aggressive">Aggressive</option>
                    <option value="positional" selected>Positional</option>
                    <option value="defensive">Defensive</option>
                  </select>
                </div>
              </div>

              <div class="feature-list">
                <div class="feature-row">
                  <div class="feature-icon" aria-hidden="true">1</div>
                  <div>
                    <strong>Rated online games</strong>
                    <span>Registered players gain and lose rating; guests and bot games are unrated.</span>
                  </div>
                </div>
                <div class="feature-row">
                  <div class="feature-icon" aria-hidden="true">2</div>
                  <div>
                    <strong>Fair matchmaking</strong>
                    <span>Paired by time control, with a rating range that widens while you wait.</span>
                  </div>
                </div>
                <div class="feature-row">
                  <div class="feature-icon" aria-hidden="true">3</div>
                  <div>
                    <strong>Your board</strong>
                    <span>Board colors from your profile carry into every game.</span>
                  </div>
                </div>
              </div>
            </aside>
          </div>
        </section>

        <section id="finding-match-screen" class="state-wrap" hidden>
          <div class="state-panel panel-card" role="status" aria-live="polite">
            <span class="eyebrow">Matchmaking</span>
            <h2 id="finding-match-text">Finding an opponent…</h2>
            <p id="finding-match-subtext"></p>
            <div class="loading-spinner" aria-hidden="true"></div>
            <p id="finding-match-status"></p>
            <button id="cancel-matchmaking-button" class="btn btn-ghost cancel-matchmaking-button">
              Cancel
            </button>
          </div>
        </section>

        <section id="countdown-screen" class="state-wrap" hidden>
          <div class="state-panel panel-card">
            <span class="eyebrow">Ready</span>
            <h2>Game starting in</h2>
            <div id="countdown-number" aria-live="assertive">3</div>
          </div>
        </section>

        <section id="game-area" class="game-wrap game-shell" hidden aria-label="Game">
          <div class="game-layout">
            <div class="game-column">
              <div id="turn-display" class="turn-display" aria-live="polite">White to move</div>

              <% ['top', 'bottom'].forEach((slot) => { %>
              <div id="player-<%= slot %>" class="player-card panel-card">
                <div class="player-card-header">
                  <div class="player-ident">
                    <span class="player-swatch" aria-hidden="true"></span>
                    <div class="player-text">
                      <strong class="player-name">Player</strong>
                      <span class="player-rating"></span>
                    </div>
                  </div>
                  <span class="check-badge" hidden>Check</span>
                </div>
                <div class="timer" role="timer" aria-label="Clock">10:00</div>
                <div class="captured-wrap">
                  <div class="captured-title">
                    Captured <span class="material-diff"></span>
                  </div>
                  <div class="captured-pieces"></div>
                </div>
              </div>
              <% }) %>
            </div>

            <div class="game-column">
              <div class="board-panel panel-card">
                <div class="board-header">
                  <div class="board-meta" id="game-badges"></div>
                  <button
                    id="flip-button"
                    type="button"
                    class="btn btn-ghost btn-small"
                    aria-label="Flip board"
                  >⇅ Flip</button>
                </div>
                <div class="board-frame">
                  <div id="board"></div>
                </div>
                <p class="board-hint">
                  Drag or click to move. Move while it's your opponent's turn to
                  premove; right-click or press Escape to cancel.
                </p>
              </div>

              <div class="game-controls-card panel-card">
                <div id="draw-banner" class="draw-banner" role="alert" hidden>
                  <span id="draw-banner-text">Your opponent offers a draw.</span>
                  <div class="draw-banner-actions">
                    <button id="draw-accept-button" type="button" class="btn btn-primary btn-small">Accept</button>
                    <button id="draw-decline-button" type="button" class="btn btn-ghost btn-small">Decline</button>
                  </div>
                </div>

                <div id="game-controls" class="controls-row">
                  <button id="draw-offer-button" type="button" class="btn btn-info control-button">
                    Offer draw
                  </button>
                  <button id="draw-withdraw-button" type="button" class="btn btn-ghost control-button" hidden>
                    Withdraw draw offer
                  </button>
                  <button id="resign-button" type="button" class="btn btn-danger control-button">
                    Resign
                  </button>
                </div>

                <div id="post-game-controls" class="controls-row" hidden>
                  <button id="rematch-button" type="button" class="btn btn-primary control-button">
                    New game
                  </button>
                  <button id="lobby-button" type="button" class="btn btn-ghost control-button">
                    Back to lobby
                  </button>
                </div>

                <div id="game-message" class="message" hidden></div>
              </div>
            </div>

            <aside class="move-history-container panel-card" aria-label="Moves and chat">
              <div class="move-history-heading">
                <h3>Moves</h3>
              </div>
              <div id="move-history" class="move-history"></div>

              <div id="opponent-chat-panel" class="chat-panel" hidden>
                <div class="move-history-heading">
                  <h3>Chat</h3>
                </div>
                <div id="chat-messages" class="chat-messages" aria-live="polite"></div>
                <form id="chat-form" class="chat-form" autocomplete="off">
                  <label for="chat-input" class="sr-only">Message</label>
                  <input
                    id="chat-input"
                    class="chat-input"
                    type="text"
                    maxlength="300"
                    placeholder="Type a message…"
                  />
                  <button type="submit" class="btn btn-info chat-send-button">Send</button>
                </form>
              </div>
            </aside>
          </div>
        </section>
      </main>

      <div id="sr-announcer" class="sr-only" aria-live="assertive"></div>
    </div>

    <script src="/socket.io/socket.io.min.js"></script>
    <script type="module" src="/javascripts/app/pages/play/index.js"></script>
  </body>
</html>
