<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Chess Game</title>
    <link rel="icon" href="/images/favicon.png" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <div class="page-grid"></div>
    <main class="page-shell">
      <div class="container split-layout">
        <section class="auth-hero">
          <span class="eyebrow">Sharper matches, cleaner focus</span>
          <h1 class="headline">Enter the board like it matters.</h1>
          <p>
            Jump into real-time matches, tune your board style, and keep your
            rating climbing in a cleaner, more immersive chess experience.
          </p>

          <div class="auth-metrics">
            <div class="metric-card">
              <strong>10 min</strong>
              <span>Per-player rapid games built for momentum.</span>
            </div>
            <div class="metric-card">
              <strong>Live</strong>
              <span>Instant matchmaking and bot practice from one home screen.</span>
            </div>
            <div class="metric-card">
              <strong>Custom</strong>
              <span>Personal board colors and profile identity settings.</span>
            </div>
          </div>
        </section>

        <section class="auth-card panel-card">
          <div>
            <h2>Welcome back</h2>
            <p>Sign in to continue your next match.</p>
          </div>

          <% if (error) { %>
          <div class="flash flash-error" role="alert"><%= error %></div>
          <% } %>

          <form action="/auth/login" method="POST" class="auth-form">
            <div class="field-group">
              <label for="email" class="field-label">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                value="<%= email %>"
                required
                class="field-input"
                placeholder="your@email.com"
              />
            </div>

            <div class="field-group">
              <label for="password" class="field-label">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                class="field-input"
                placeholder="Enter your password"
              />
            </div>

            <button type="submit" class="btn btn-primary">Sign In</button>
          </form>

          <div class="auth-divider"><span>or</span></div>

          <form action="/auth/guest" method="POST">
            <button type="submit" class="btn btn-info" style="width: 100%">
              <span>Quick guest match</span>
            </button>
          </form>

          <div class="auth-footer">
            Don't have an account?
            <a href="/auth/register">Create one here</a>
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
