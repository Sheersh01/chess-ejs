<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Chess Game</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/images/favicon.png" />
  </head>
  <body class="bg-zinc-900 min-h-screen">
    <div
      class="w-full min-h-screen flex items-center justify-center px-4 py-8"
    >
      <div class="max-w-md w-full">
        <!-- Header -->
        <div class="text-center mb-8">
          <h1 class="text-4xl sm:text-5xl font-bold text-white mb-2">
            ♔ Chess Game ♚
          </h1>
          <p class="text-zinc-400 text-sm sm:text-base">
            Sign in to start playing
          </p>
        </div>

        <!-- Login Form -->
        <div class="bg-zinc-800 rounded-lg shadow-2xl p-6 sm:p-8">
          <h2 class="text-2xl font-bold text-white mb-6 text-center">
            Welcome Back
          </h2>

          <% if (error) { %>
          <div
            class="bg-red-500 bg-opacity-10 border border-red-500 text-red-500 px-4 py-3 rounded-lg mb-6"
            role="alert"
          >
            <p class="text-sm"><%= error %></p>
          </div>
          <% } %>

          <form action="/auth/login" method="POST" class="space-y-5">
            <!-- Email -->
            <div>
              <label
                for="email"
                class="block text-sm font-medium text-zinc-300 mb-2"
              >
                Email Address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                value="<%= email %>"
                required
                class="w-full px-4 py-3 bg-zinc-700 text-white border border-zinc-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                placeholder="your@email.com"
              />
            </div>

            <!-- Password -->
            <div>
              <label
                for="password"
                class="block text-sm font-medium text-zinc-300 mb-2"
              >
                Password
              </label>
              <input
                type="password"
                id="password"
                name="password"
                required
                class="w-full px-4 py-3 bg-zinc-700 text-white border border-zinc-600 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                placeholder="Enter your password"
              />
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-4 rounded-lg transition transform hover:scale-105 active:scale-95 shadow-lg"
            >
              Sign In
            </button>
          </form>

          <!-- Divider -->
          <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-zinc-600"></div>
            </div>
            <div class="relative flex justify-center text-sm">
              <span class="px-4 bg-zinc-800 text-zinc-400">OR</span>
            </div>
          </div>

          <!-- Guest Play Button -->
          <form action="/auth/guest" method="POST">
            <button
              type="submit"
              class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition transform hover:scale-105 active:scale-95 shadow-lg flex items-center justify-center gap-2"
            >
              <span>🎮</span>
              <span>Play as Guest</span>
            </button>
          </form>

          <!-- Register Link -->
          <div class="mt-6 text-center">
            <p class="text-zinc-400 text-sm">
              Don't have an account?
              <a
                href="/auth/register"
                class="text-green-500 hover:text-green-400 font-semibold transition"
              >
                Sign up here
              </a>
            </p>
          </div>
        </div>

        <!-- Back to Home -->
        <div class="mt-6 text-center">
          <a
            href="/"
            class="text-zinc-500 hover:text-zinc-400 text-sm transition"
          >
            ← Back to Home
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
