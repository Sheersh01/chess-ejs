<%
  const displayName = user.displayName || user.username;
  const colors = [
    { id: 'boardLight', label: 'Light squares', value: user.settings?.boardLight || '#f0d9b5' },
    { id: 'boardDark', label: 'Dark squares', value: user.settings?.boardDark || '#b58863' },
    { id: 'hintColor', label: 'Move hints', value: user.settings?.hintColor || '#14551e' },
  ];
%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Profile' }) %>
  </head>
  <body>
    <%- include('partials/small-device') %>

    <div id="desktop-app">
      <%- include('partials/topbar', { user, active: 'profile' }) %>

      <main id="main-content" class="page" tabindex="-1">
        <div class="container">
          <% if (error) { %>
          <div class="flash flash-error" role="alert"><%= error %></div>
          <% } %>
          <% if (success) { %>
          <div class="flash flash-success" role="status"><%= success %></div>
          <% } %>

          <section class="card card-body profile-hero" aria-label="Profile summary">
            <span class="avatar avatar-lg" aria-hidden="true"><%= displayName.charAt(0) %></span>
            <div>
              <h1 class="page-title"><%= displayName %></h1>
              <p class="muted">
                @<%= user.username %>
                <% if (user.isGuest) { %><span class="tag">Guest</span><% } %>
              </p>
            </div>
            <div class="stat-grid">
              <div class="stat"><strong><%= user.rating %></strong><span>Rating</span></div>
              <div class="stat stat-win"><strong><%= user.wins || 0 %></strong><span>Wins</span></div>
              <div class="stat stat-loss"><strong><%= user.losses || 0 %></strong><span>Losses</span></div>
              <div class="stat stat-draw"><strong><%= user.draws || 0 %></strong><span>Draws</span></div>
            </div>
          </section>

          <div class="profile-layout">
            <div class="stack">
              <form id="profile-settings-form" action="/profile" method="POST" class="card">
                <div class="card-header">
                  <h2 class="card-title">Profile & board</h2>
                </div>
                <div class="card-body stack">
                  <div class="form-grid">
                    <div class="field-group">
                      <label for="username" class="field-label">Username</label>
                      <input id="username" type="text" value="<%= user.username %>" class="field-input" readonly aria-describedby="username-help" />
                      <div id="username-help" class="field-help">Your username can't be changed.</div>
                    </div>
                    <div class="field-group">
                      <label for="displayName" class="field-label">Display name</label>
                      <input
                        id="displayName"
                        name="displayName"
                        type="text"
                        maxlength="30"
                        value="<%= user.displayName || '' %>"
                        placeholder="<%= user.username %>"
                        class="field-input"
                        aria-describedby="display-help"
                      />
                      <div id="display-help" class="field-help">Shown to opponents and in game history.</div>
                    </div>
                  </div>

                  <div>
                    <h3 class="section-title">Board colors</h3>
                    <p class="section-subtitle">Pick colors with enough contrast to read pieces quickly.</p>
                    <div class="palette">
                      <div class="color-fields">
                        <% colors.forEach((color) => { %>
                        <div class="color-field">
                          <label for="<%= color.id %>" class="field-label"><%= color.label %></label>
                          <input id="<%= color.id %>" name="<%= color.id %>" type="color" value="<%= color.value %>" class="color-picker" />
                          <input
                            id="<%= color.id %>Text"
                            type="text"
                            value="<%= color.value %>"
                            class="field-text"
                            aria-label="<%= color.label %> hex value"
                          />
                        </div>
                        <% }) %>
                      </div>
                      <div>
                        <div class="preview-board" aria-label="Board color preview" role="img">
                          <% for (let i = 0; i < 16; i++) { %>
                          <div class="preview-square" data-index="<%= i %>"></div>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="form-actions">
                  <a href="/" class="btn btn-quiet">Cancel</a>
                  <button id="save-settings-button" type="submit" class="btn btn-primary" disabled>Save changes</button>
                </div>
              </form>

              <section class="card" aria-labelledby="recent-title">
                <div class="card-header">
                  <h2 id="recent-title" class="card-title">Recent games</h2>
                  <a class="btn btn-quiet btn-sm" href="/games">All games →</a>
                </div>
                <% if (user.isGuest) { %>
                <div class="empty-state"><span>Game history is only saved for registered players.</span></div>
                <% } else if (!user.gameHistory || user.gameHistory.length === 0) { %>
                <div class="empty-state">
                  <strong>No saved games yet</strong>
                  <span>Finish a game and it will appear here.</span>
                </div>
                <% } else { %>
                <div class="history-list">
                  <% user.gameHistory.forEach((game) => {
                    const tone = { win: 'win', loss: 'loss', draw: 'draw' }[game.result] || 'neutral';
                  %>
                  <article class="history-row">
                    <span class="result-pill result-<%= tone %>"><%= game.result %></span>
                    <span class="color-dot color-dot-<%= game.color %>" title="You played <%= game.color %>"></span>
                    <div class="history-main">
                      <strong>vs <%= game.opponent %></strong>
                      <span>
                        <%= game.reason || 'Completed game' %> ·
                        <%= game.mode === 'bot' ? 'Bot' : 'Online' %> ·
                        <%= new Date(game.playedAt).toLocaleDateString() %>
                      </span>
                    </div>
                    <span class="history-rating">
                      <% if (game.rated === false) { %>
                      Unrated
                      <% } else if (typeof game.ratingBefore === 'number' && typeof game.ratingAfter === 'number') { %>
                      <%= game.ratingAfter %>
                      (<%= game.ratingAfter - game.ratingBefore >= 0 ? '+' : '' %><%= game.ratingAfter - game.ratingBefore %>)
                      <% } %>
                    </span>
                    <% if (game.gameId) { %>
                    <a class="btn btn-ghost btn-sm" href="/games/<%= encodeURIComponent(game.gameId) %>">Review</a>
                    <% } %>
                  </article>
                  <% }) %>
                </div>
                <% } %>
              </section>
            </div>

            <div class="stack">
              <% if (!user.isGuest) { %>
              <section class="card" aria-labelledby="password-title">
                <div class="card-header">
                  <h2 id="password-title" class="card-title">Change password</h2>
                </div>
                <form id="change-password-form" action="/profile/password" method="POST" class="card-body stack">
                  <p class="muted help-note">This signs you out on every other device.</p>
                  <div class="field-group">
                    <label for="currentPassword" class="field-label">Current password</label>
                    <input id="currentPassword" name="currentPassword" type="password" class="field-input" autocomplete="current-password" required />
                  </div>
                  <div class="field-group">
                    <label for="newPassword" class="field-label">New password</label>
                    <input id="newPassword" name="newPassword" type="password" class="field-input" autocomplete="new-password" minlength="8" maxlength="72" required aria-describedby="new-password-help" />
                    <div id="new-password-help" class="field-help">At least 8 characters</div>
                  </div>
                  <button type="submit" class="btn btn-primary">Update password</button>
                </form>
              </section>
              <% } %>

              <section class="card" aria-labelledby="danger-title">
                <div class="card-header">
                  <h2 id="danger-title" class="card-title">Delete account</h2>
                </div>
                <div class="card-body">
                  <% if (!user.isGuest) { %>
                  <form id="delete-account-form" action="/profile/delete" method="POST" class="stack">
                    <p class="muted help-note">
                      Permanently removes your profile, rating and history. This can't be undone.
                    </p>
                    <div class="field-group">
                      <label for="confirmDelete" class="field-label">Type DELETE to confirm</label>
                      <input id="confirmDelete" name="confirmDelete" type="text" class="field-input" placeholder="DELETE" autocomplete="off" required />
                    </div>
                    <button type="submit" class="btn btn-danger-outline">Delete my account</button>
                  </form>
                  <% } else { %>
                  <p class="muted">Guest sessions have no stored account. It ends when you exit.</p>
                  <% } %>
                </div>
              </section>
            </div>
          </div>
        </div>
      </main>
    </div>

    <script type="module" src="/javascripts/app/pages/profile.js"></script>
  </body>
</html>
